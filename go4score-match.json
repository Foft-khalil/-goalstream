{
  "code": 200,
  "data": {
    "description": "",
    "external": {},
    "html": "<html lang=\"en\" data-theme=\"dark\"><head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <meta name=\"robots\" content=\"noindex, nofollow\">\n    <title>Match Stream Link Generator - Sport TV</title>\n    \n    <style>\n        * {\n            margin: 0;\n            padding: 0;\n            box-sizing: border-box;\n        }\n        \n        /* CSS Variables for Theme */\n        :root {\n            --bg-gradient-start: #1a1a2e;\n            --bg-gradient-end: #16213e;\n            --text-primary: #ffffff;\n            --text-secondary: #a0a0a0;\n            --card-bg: rgba(0, 0, 0, 0.6);\n            --card-border: rgba(255, 255, 255, 0.1);\n            --header-bg: rgba(0, 0, 0, 0.5);\n            --button-bg-start: #667eea;\n            --button-bg-end: #764ba2;\n            --button-shadow: rgba(102, 126, 234, 0.4);\n            --input-bg: rgba(255, 255, 255, 0.05);\n            --input-border: rgba(255, 255, 255, 0.1);\n        }\n        \n        /* Light Theme */\n        [data-theme=\"light\"] {\n            --bg-gradient-start: #f0f4f8;\n            --bg-gradient-end: #e2e8f0;\n            --text-primary: #1a202c;\n            --text-secondary: #4a5568;\n            --card-bg: rgba(255, 255, 255, 0.95);\n            --card-border: rgba(0, 0, 0, 0.1);\n            --header-bg: rgba(255, 255, 255, 0.95);\n            --button-bg-start: #4299e1;\n            --button-bg-end: #3182ce;\n            --button-shadow: rgba(66, 153, 225, 0.4);\n            --input-bg: rgba(0, 0, 0, 0.05);\n            --input-border: rgba(0, 0, 0, 0.15);\n        }\n        \n        body {\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;\n            background: linear-gradient(135deg, var(--bg-gradient-start) 0%, var(--bg-gradient-end) 100%);\n            color: var(--text-primary);\n            line-height: 1.6;\n            min-height: 100vh;\n            transition: background 0.3s ease, color 0.3s ease;\n        }\n        \n        .container {\n            max-width: 1200px;\n            margin: 0 auto;\n            padding: 15px;\n        }\n        \n        /* Header */\n        .header {\n            background: var(--header-bg);\n            backdrop-filter: blur(10px);\n            border-bottom: 2px solid var(--card-border);\n            padding: 15px 0;\n            margin-bottom: 30px;\n            transition: background 0.3s ease, border-color 0.3s ease;\n        }\n        \n        .header-content {\n            display: flex;\n            align-items: center;\n            justify-content: space-between;\n            flex-wrap: wrap;\n            gap: 15px;\n        }\n        \n        .logo {\n            font-size: 24px;\n            font-weight: 800;\n            color: var(--text-primary);\n            text-decoration: none;\n            text-shadow: 0 2px 10px var(--button-shadow);\n            cursor: pointer;\n            transition: color 0.3s ease;\n        }\n        \n        .header-actions {\n            display: flex;\n            align-items: center;\n            gap: 15px;\n        }\n        \n        /* Language Selector */\n        .language-selector {\n            position: relative;\n        }\n        \n        .lang-button {\n            background: var(--card-bg);\n            border: 2px solid var(--card-border);\n            border-radius: 10px;\n            padding: 10px 20px;\n            color: var(--text-primary);\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            gap: 8px;\n            font-size: 14px;\n            font-weight: 600;\n            transition: all 0.3s ease;\n        }\n        \n        .lang-button:hover {\n            border-color: var(--button-bg-start);\n            transform: translateY(-2px);\n        }\n        \n        .lang-dropdown {\n            position: absolute;\n            top: 100%;\n            right: 0;\n            margin-top: 8px;\n            background: var(--card-bg);\n            border: 2px solid var(--card-border);\n            border-radius: 10px;\n            padding: 10px;\n            min-width: 200px;\n            display: none;\n            z-index: 1000;\n            backdrop-filter: blur(10px);\n            max-height: 400px;\n            overflow-y: auto;\n        }\n        \n        .lang-dropdown.active {\n            display: block;\n            animation: slideDown 0.3s ease;\n        }\n        \n        @keyframes slideDown {\n            from {\n                opacity: 0;\n                transform: translateY(-10px);\n            }\n            to {\n                opacity: 1;\n                transform: translateY(0);\n            }\n        }\n        \n        .lang-option {\n            padding: 10px 15px;\n            cursor: pointer;\n            border-radius: 8px;\n            transition: background 0.2s ease;\n            display: flex;\n            align-items: center;\n            gap: 10px;\n        }\n        \n        .lang-option:hover {\n            background: rgba(102, 126, 234, 0.2);\n        }\n        \n        .lang-option.active {\n            background: rgba(102, 126, 234, 0.3);\n            font-weight: 600;\n        }\n        \n        /* Theme Toggle */\n        .theme-toggle {\n            background: var(--card-bg);\n            border: 2px solid var(--card-border);\n            border-radius: 50px;\n            padding: 8px 16px;\n            cursor: pointer;\n            display: flex;\n            align-items: center;\n            gap: 8px;\n            transition: all 0.3s ease;\n            font-size: 20px;\n            color: var(--text-primary);\n        }\n        \n        .theme-toggle:hover {\n            transform: scale(1.05);\n            border-color: var(--button-bg-start);\n        }\n        \n        /* Card Styles */\n        .card {\n            background: var(--card-bg);\n            border: 2px solid var(--card-border);\n            border-radius: 12px;\n            padding: 30px;\n            margin-bottom: 30px;\n            transition: all 0.3s ease;\n        }\n        \n        .card-title {\n            font-size: 24px;\n            font-weight: 700;\n            margin-bottom: 20px;\n            color: var(--text-primary);\n            display: flex;\n            align-items: center;\n            gap: 10px;\n        }\n        \n        /* Form Styles */\n        .form-group {\n            margin-bottom: 25px;\n        }\n        \n        .form-label {\n            display: block;\n            margin-bottom: 10px;\n            font-size: 16px;\n            font-weight: 600;\n            color: var(--text-primary);\n        }\n        \n        .form-input {\n            width: 100%;\n            padding: 15px 20px;\n            border-radius: 10px;\n            border: 2px solid var(--card-border);\n            background: var(--input-bg);\n            color: var(--text-primary);\n            font-size: 16px;\n            transition: all 0.3s ease;\n        }\n        \n        .form-input:focus {\n            outline: none;\n            border-color: var(--button-bg-start);\n            box-shadow: 0 0 0 3px var(--input-bg);\n        }\n        \n        .form-input::placeholder {\n            color: var(--text-secondary);\n            opacity: 0.6;\n        }\n        \n        .form-hint {\n            font-size: 13px;\n            color: var(--text-secondary);\n            margin-top: 8px;\n            display: block;\n        }\n        \n        .form-row {\n            display: grid;\n            grid-template-columns: 1fr 1fr;\n            gap: 20px;\n        }\n        \n        /* Button Styles */\n        .btn {\n            padding: 15px 40px;\n            border-radius: 10px;\n            border: none;\n            font-size: 16px;\n            font-weight: 600;\n            cursor: pointer;\n            transition: all 0.3s ease;\n            display: inline-flex;\n            align-items: center;\n            gap: 10px;\n        }\n        \n        .btn-primary {\n            background: linear-gradient(135deg, var(--button-bg-start) 0%, var(--button-bg-end) 100%);\n            color: white;\n            box-shadow: 0 4px 15px var(--button-shadow);\n        }\n        \n        .btn-primary:hover {\n            transform: translateY(-2px);\n            box-shadow: 0 6px 20px var(--button-shadow);\n        }\n        \n        .btn-primary:disabled {\n            opacity: 0.5;\n            cursor: not-allowed;\n            transform: none;\n        }\n        \n        /* Match List */\n        .matches-container {\n            display: none;\n        }\n        \n        .matches-container.active {\n            display: block;\n        }\n        \n        .match-item {\n            background: var(--card-bg);\n            border: 2px solid var(--card-border);\n            border-radius: 12px;\n            padding: 20px;\n            margin-bottom: 15px;\n            transition: all 0.3s ease;\n        }\n        \n        .match-item:hover {\n            border-color: var(--button-bg-start);\n            transform: translateY(-2px);\n        }\n        \n        .match-header {\n            display: flex;\n            justify-content: space-between;\n            align-items: center;\n            margin-bottom: 15px;\n            flex-wrap: wrap;\n            gap: 10px;\n        }\n        \n        .match-teams {\n            font-size: 18px;\n            font-weight: 600;\n            color: var(--text-primary);\n        }\n        \n        .match-info {\n            display: flex;\n            gap: 15px;\n            align-items: center;\n            font-size: 14px;\n            color: var(--text-secondary);\n            flex-wrap: wrap;\n        }\n        \n        .match-league {\n            font-weight: 600;\n        }\n        \n        .match-time {\n            padding: 4px 10px;\n            background: rgba(102, 126, 234, 0.2);\n            border-radius: 6px;\n        }\n        \n        .match-url-container {\n            display: flex;\n            gap: 10px;\n            align-items: center;\n        }\n        \n        .match-url {\n            flex: 1;\n            padding: 12px 15px;\n            background: var(--input-bg);\n            border: 1px solid var(--card-border);\n            border-radius: 8px;\n            color: var(--text-primary);\n            font-family: monospace;\n            font-size: 14px;\n            word-break: break-all;\n        }\n        \n        .btn-copy {\n            padding: 12px 20px;\n            background: var(--button-bg-start);\n            color: white;\n            border: none;\n            border-radius: 8px;\n            cursor: pointer;\n            font-weight: 600;\n            transition: all 0.3s ease;\n            white-space: nowrap;\n        }\n        \n        .btn-copy:hover {\n            background: var(--button-bg-end);\n        }\n        \n        .btn-copy.copied {\n            background: #28a745;\n        }\n        \n        /* Loading Spinner */\n        .loading {\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            padding: 40px;\n            color: var(--text-secondary);\n        }\n        \n        .spinner {\n            width: 50px;\n            height: 50px;\n            border: 4px solid var(--card-border);\n            border-top: 4px solid var(--button-bg-start);\n            border-radius: 50%;\n            animation: spin 1s linear infinite;\n            margin-bottom: 15px;\n        }\n        \n        @keyframes spin {\n            0% { transform: rotate(0deg); }\n            100% { transform: rotate(360deg); }\n        }\n        \n        /* Info Alert */\n        .alert {\n            padding: 15px 20px;\n            border-radius: 10px;\n            margin-bottom: 20px;\n            display: flex;\n            align-items: flex-start;\n            gap: 12px;\n        }\n        \n        .alert-info {\n            background: rgba(102, 126, 234, 0.15);\n            border: 2px solid rgba(102, 126, 234, 0.3);\n            color: var(--text-primary);\n        }\n        \n        .alert-icon {\n            font-size: 24px;\n            flex-shrink: 0;\n        }\n        \n        /* Responsive */\n        @media (max-width: 768px) {\n            .form-row {\n                grid-template-columns: 1fr;\n            }\n            \n            .header-content {\n                flex-direction: column;\n                align-items: stretch;\n            }\n            \n            .match-header {\n                flex-direction: column;\n                align-items: flex-start;\n            }\n            \n            .match-url-container {\n                flex-direction: column;\n            }\n            \n            .btn-copy {\n                width: 100%;\n            }\n        }\n    </style>\n</head>\n<body>\n    <!-- Header -->\n    <div class=\"header\">\n        <div class=\"container\">\n            <div class=\"header-content\">\n                <div class=\"logo\" id=\"logoText\">⚽ Sport TV - Link Generator</div>\n                \n                <div class=\"header-actions\">\n                    <!-- Language Selector -->\n                    <div class=\"language-selector\">\n                        <button class=\"lang-button\" onclick=\"toggleLanguageDropdown()\">\n                            <span id=\"currentLangFlag\">🇬🇧</span>\n                            <span id=\"currentLangText\">English</span>\n                            <span>▼</span>\n                        </button>\n                        <div class=\"lang-dropdown\" id=\"langDropdown\">\n                            <div class=\"lang-option active\" data-lang=\"en\" onclick=\"changeLanguage('en', '🇬🇧', 'English')\">\n                                <span>🇬🇧</span> English\n                            </div>\n                            <div class=\"lang-option\" data-lang=\"ar\" onclick=\"changeLanguage('ar', '🇸🇦', 'العربية')\">\n                                <span>🇸🇦</span> العربية\n                            </div>\n                            <div class=\"lang-option\" data-lang=\"es\" onclick=\"changeLanguage('es', '🇪🇸', 'Español')\">\n                                <span>🇪🇸</span> Español\n                            </div>\n                            <div class=\"lang-option\" data-lang=\"fr\" onclick=\"changeLanguage('fr', '🇫🇷', 'Français')\">\n                                <span>🇫🇷</span> Français\n                            </div>\n                            <div class=\"lang-option\" data-lang=\"de\" onclick=\"changeLanguage('de', '🇩🇪', 'Deutsch')\">\n                                <span>🇩🇪</span> Deutsch\n                            </div>\n                            <div class=\"lang-option\" data-lang=\"it\" onclick=\"changeLanguage('it', '🇮🇹', 'Italiano')\">\n                                <span>🇮🇹</span> Italiano\n                            </div>\n                            <div class=\"lang-option\" data-lang=\"pt\" onclick=\"changeLanguage('pt', '🇵🇹', 'Português')\">\n                                <span>🇵🇹</span> Português\n                            </div>\n                            <div class=\"lang-option\" data-lang=\"tr\" onclick=\"changeLanguage('tr', '🇹🇷', 'Türkçe')\">\n                                <span>🇹🇷</span> Türkçe\n                            </div>\n                            <div class=\"lang-option\" data-lang=\"ru\" onclick=\"changeLanguage('ru', '🇷🇺', 'Русский')\">\n                                <span>🇷🇺</span> Русский\n                            </div>\n                            <div class=\"lang-option\" data-lang=\"zh\" onclick=\"changeLanguage('zh', '🇨🇳', '中文')\">\n                                <span>🇨🇳</span> 中文\n                            </div>\n                            <div class=\"lang-option\" data-lang=\"ja\" onclick=\"changeLanguage('ja', '🇯🇵', '日本語')\">\n                                <span>🇯🇵</span> 日本語\n                            </div>\n                            <div class=\"lang-option\" data-lang=\"hi\" onclick=\"changeLanguage('hi', '🇮🇳', 'हिन्दी')\">\n                                <span>🇮🇳</span> हिन्दी\n                            </div>\n                        </div>\n                    </div>\n                    \n                    <!-- Theme Toggle -->\n                    <button class=\"theme-toggle\" id=\"themeToggle\" onclick=\"toggleTheme()\" title=\"Toggle Dark/Light Mode\">\n                        <span class=\"theme-icon\" id=\"themeIcon\">🌙</span>\n                    </button>\n                </div>\n            </div>\n        </div>\n    </div>\n    \n    <!-- Main Content -->\n    <div class=\"container\">\n        <!-- Generator Form -->\n        <div class=\"card\">\n            <div class=\"card-title\">\n                <span>🔗</span>\n                <span id=\"formTitle\">Generate Stream Links for Your Website</span>\n            </div>\n            \n            <div class=\"alert alert-info\">\n                <div class=\"alert-icon\">💡</div>\n                <div>\n                    <strong id=\"infoTitle\">For Website Owners &amp; Developers</strong><br>\n                    <span id=\"infoText\">Generate custom stream links with your branding. Each link will return visitors to YOUR website and give you free SEO backlinks!</span>\n                </div>\n            </div>\n            \n            <form id=\"generatorForm\" onsubmit=\"generateLinks(event)\">\n                <div class=\"form-row\">\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" id=\"domainLabel\">Your Website Domain *</label>\n                        <input type=\"text\" class=\"form-input\" id=\"domainInput\" placeholder=\"example.com\" required=\"\">\n                        <span class=\"form-hint\" id=\"domainHint\">Enter without http:// or www</span>\n                    </div>\n                    \n                    <div class=\"form-group\">\n                        <label class=\"form-label\" id=\"nameLabel\">Website Name (Optional - for SEO)</label>\n                        <input type=\"text\" class=\"form-input\" id=\"nameInput\" placeholder=\"Yalla Shoot\">\n                        <span class=\"form-hint\" id=\"nameHint\">Your brand name displayed on stream page</span>\n                    </div>\n                </div>\n                \n                <div class=\"form-row\">\n                    <div class=\"form-group\">\n                        <label class=\"form-label\" id=\"streamLangLabel\">Stream Page Language</label>\n                        <select class=\"form-input\" id=\"streamLangSelect\">\n                            <option value=\"en\">English</option>\n                            <option value=\"ar\">العربية (Arabic)</option>\n                        </select>\n                        <span class=\"form-hint\" id=\"streamLangHint\">Language of the streaming page</span>\n                    </div>\n                    \n                    <div class=\"form-group\">\n                        <label class=\"form-label\" id=\"dateLabel\">Match Date</label>\n                        <input type=\"date\" class=\"form-input\" id=\"dateInput\" required=\"\">\n                        <span class=\"form-hint\" id=\"dateHint\">Select the date for matches</span>\n                    </div>\n                </div>\n                \n                <button type=\"submit\" class=\"btn btn-primary\" id=\"generateBtn\">\n                    <span>🚀</span>\n                    <span id=\"generateBtnText\">Generate Stream Links</span>\n                </button>\n            </form>\n        </div>\n        \n        <!-- Matches List -->\n        <div class=\"matches-container\" id=\"matchesContainer\">\n            <div class=\"card\">\n                <div class=\"card-title\">\n                    <span>⚽</span>\n                    <span id=\"matchesTitle\">Available Matches</span>\n                </div>\n                <div id=\"matchesList\"></div>\n            </div>\n        </div>\n    </div>\n    \n    <script>\n        // Set default date to today\n        document.getElementById('dateInput').valueAsDate = new Date();\n        \n        // Current page language\n        let currentPageLang = 'en';\n        \n        // Current stream language preference\n        let currentStreamLang = 'en';\n        \n        // Theme Management\n        const getTheme = () => {\n            return localStorage.getItem('theme') || 'dark';\n        };\n        \n        const setTheme = (theme) => {\n            document.documentElement.setAttribute('data-theme', theme);\n            localStorage.setItem('theme', theme);\n            updateThemeIcon(theme);\n        };\n        \n        const updateThemeIcon = (theme) => {\n            const icon = document.getElementById('themeIcon');\n            icon.textContent = theme === 'dark' ? '🌙' : '☀️';\n        };\n        \n        window.toggleTheme = () => {\n            const currentTheme = getTheme();\n            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';\n            setTheme(newTheme);\n        };\n        \n        // Update UI Language\n        const updateUILanguage = (lang) => {\n            const translations = {\n                en: {\n                    logoText: '⚽ Sport TV - Link Generator',\n                    formTitle: 'Generate Stream Links for Your Website',\n                    infoTitle: 'For Website Owners & Developers',\n                    infoText: 'Generate custom stream links with your branding. Each link will return visitors to YOUR website and give you free SEO backlinks!',\n                    domainLabel: 'Your Website Domain *',\n                    domainHint: 'Enter without http:// or www',\n                    nameLabel: 'Website Name (Optional - for SEO)',\n                    nameHint: 'Your brand name displayed on stream page',\n                    streamLangLabel: 'Stream Page Language',\n                    streamLangHint: 'Language of the streaming page',\n                    dateLabel: 'Match Date',\n                    dateHint: 'Select the date for matches',\n                    generateBtnText: 'Generate Stream Links',\n                    matchesTitle: 'Available Matches',\n                    copyBtn: 'Copy',\n                    copiedBtn: '✓ Copied!',\n                    noMatches: 'No matches found for this date',\n                    loading: 'Loading matches...',\n                    errorLoading: 'Error loading matches. Please try again.',\n                    vs: 'vs'\n                },\n                ar: {\n                    logoText: '⚽ سبورت - مُنشئ الروابط',\n                    formTitle: 'أنشئ روابط البث لموقعك',\n                    infoTitle: 'لأصحاب المواقع والمطورين',\n                    infoText: 'أنشئ روابط بث مخصصة بعلامتك التجارية. كل رابط سيعيد الزوار إلى موقعك ويمنحك روابط SEO مجانية!',\n                    domainLabel: 'نطاق موقعك *',\n                    domainHint: 'أدخل بدون http:// أو www',\n                    nameLabel: 'اسم الموقع (اختياري - لتحسين SEO)',\n                    nameHint: 'اسم علامتك التجارية يظهر في صفحة البث',\n                    streamLangLabel: 'لغة صفحة البث',\n                    streamLangHint: 'لغة صفحة المشاهدة',\n                    dateLabel: 'تاريخ المباراة',\n                    dateHint: 'اختر تاريخ المباريات',\n                    generateBtnText: 'إنشاء روابط البث',\n                    matchesTitle: 'المباريات المتاحة',\n                    copyBtn: 'نسخ',\n                    copiedBtn: '✓ تم النسخ!',\n                    noMatches: 'لا توجد مباريات في هذا التاريخ',\n                    loading: 'جاري تحميل المباريات...',\n                    errorLoading: 'خطأ في تحميل المباريات. حاول مرة أخرى.',\n                    vs: 'ضد'\n                },\n                es: {\n                    logoText: '⚽ Sport TV - Generador',\n                    formTitle: 'Generar Enlaces de Transmisión para Tu Sitio Web',\n                    infoTitle: 'Para Propietarios y Desarrolladores',\n                    infoText: '¡Genera enlaces de transmisión personalizados con tu marca. Cada enlace devolverá visitantes a TU sitio web y te dará backlinks SEO gratis!',\n                    domainLabel: 'Tu Dominio *',\n                    domainHint: 'Ingrese sin http:// o www',\n                    nameLabel: 'Nombre del Sitio (Opcional - para SEO)',\n                    nameHint: 'Tu marca aparecerá en la página de transmisión',\n                    streamLangLabel: 'Idioma de la Página',\n                    streamLangHint: 'Idioma de la página de transmisión',\n                    dateLabel: 'Fecha del Partido',\n                    dateHint: 'Selecciona la fecha de los partidos',\n                    generateBtnText: 'Generar Enlaces',\n                    matchesTitle: 'Partidos Disponibles',\n                    copyBtn: 'Copiar',\n                    copiedBtn: '✓ Copiado!',\n                    noMatches: 'No se encontraron partidos para esta fecha',\n                    loading: 'Cargando partidos...',\n                    errorLoading: 'Error al cargar partidos. Inténtalo de nuevo.',\n                    vs: 'vs'\n                },\n                fr: {\n                    logoText: '⚽ Sport TV - Générateur',\n                    formTitle: 'Générer des Liens de Diffusion pour Votre Site',\n                    infoTitle: 'Pour Propriétaires et Développeurs',\n                    infoText: 'Générez des liens personnalisés avec votre marque. Chaque lien ramènera les visiteurs sur VOTRE site et vous donnera des backlinks SEO gratuits!',\n                    domainLabel: 'Votre Domaine *',\n                    domainHint: 'Entrez sans http:// ou www',\n                    nameLabel: 'Nom du Site (Optionnel - pour SEO)',\n                    nameHint: 'Votre marque apparaîtra sur la page de diffusion',\n                    streamLangLabel: 'Langue de la Page',\n                    streamLangHint: 'Langue de la page de diffusion',\n                    dateLabel: 'Date du Match',\n                    dateHint: 'Sélectionnez la date des matchs',\n                    generateBtnText: 'Générer les Liens',\n                    matchesTitle: 'Matchs Disponibles',\n                    copyBtn: 'Copier',\n                    copiedBtn: '✓ Copié!',\n                    noMatches: 'Aucun match trouvé pour cette date',\n                    loading: 'Chargement des matchs...',\n                    errorLoading: 'Erreur de chargement. Réessayez.',\n                    vs: 'vs'\n                }\n            };\n            \n            const t = translations[lang] || translations.en;\n            \n            Object.keys(t).forEach(key => {\n                const el = document.getElementById(key);\n                if (el) {\n                    if (el.tagName === 'INPUT' || el.tagName === 'BUTTON') {\n                        el.value = t[key];\n                    } else {\n                        el.textContent = t[key];\n                    }\n                }\n            });\n            \n            // Store current translations globally for use in generateLinks\n            window.currentTranslations = t;\n        };\n        \n        // Initialize theme\n        setTheme(getTheme());\n        \n        // Language Dropdown (Global function for onclick)\n        window.toggleLanguageDropdown = () => {\n            const dropdown = document.getElementById('langDropdown');\n            dropdown.classList.toggle('active');\n        };\n        \n        // Close dropdown when clicking outside\n        document.addEventListener('click', (e) => {\n            if (!e.target.closest('.language-selector')) {\n                document.getElementById('langDropdown').classList.remove('active');\n            }\n        });\n        \n        // Change Language (Global function for onclick)\n        window.changeLanguage = (lang, flag, name) => {\n            currentPageLang = lang;\n            document.getElementById('currentLangFlag').textContent = flag;\n            document.getElementById('currentLangText').textContent = name;\n            \n            // Update active state\n            document.querySelectorAll('.lang-option').forEach(opt => {\n                opt.classList.remove('active');\n                if (opt.dataset.lang === lang) {\n                    opt.classList.add('active');\n                }\n            });\n            \n            // Update page direction for RTL languages\n            document.documentElement.setAttribute('dir', lang === 'ar' ? 'rtl' : 'ltr');\n            \n            // Close dropdown\n            document.getElementById('langDropdown').classList.remove('active');\n            \n            // Update UI text based on language\n            updateUILanguage(lang);\n        };\n        \n        // Initialize with default language\n        updateUILanguage(currentPageLang);\n        \n        // Generate Links (Global function for onsubmit)\n        window.generateLinks = async (event) => {\n            event.preventDefault();\n            \n            const domain = document.getElementById('domainInput').value.trim();\n            const websiteName = document.getElementById('nameInput').value.trim();\n            const streamLang = document.getElementById('streamLangSelect').value;\n            const date = document.getElementById('dateInput').value;\n            \n            if (!domain || !date) {\n                alert('Please fill in required fields');\n      