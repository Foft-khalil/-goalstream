generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  role          String    @default("USER")
  favoriteTeams String?   // JSON string of favorite teams
  password      String?   // For email/password auth
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Match {
  id          String   @id @default(cuid())
  homeTeam    String
  awayTeam    String
  homeLogo    String?
  awayLogo    String?
  homeScore   Int?
  awayScore   Int?
  status      String   @default("upcoming") // upcoming, live, finished
  competition String?
  matchDate   DateTime
  streamUrl   String?
  channelName String?
  channelLogo String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Channel {
  id          String    @id @default(cuid())
  tvgId       String?
  name        String
  logo        String?
  group       String?
  url         String
  country     String?
  isActive    Boolean   @default(true)
  lastChecked DateTime?
  source      String    @default("iptv-org") // iptv-org or manual
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([name, url])
}
