function(c){return({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'})[c]})}\n\nfunction statusInfo(s){\n  s=parseInt(s);\n  if(s===1)return{label:'<span class=\"dot\" aria-hidden=\"true\"></span>Live',cls:'badge-live',live:true};\n  if(s===2)return{label:'Finished',cls:'badge-finished',live:false};\n  return{label:'Upcoming',cls:'badge-upcoming',live:false};\n}\n\nfunction card(m){\n  var st=statusInfo(m.status);\n  var live=m.status===1||m.status===3;\n  var link=STREAM_URL+'?m='+encodeURIComponent(m.id)+'&lang='+encodeURIComponent(STREAM_LANG);\n  var center;\n  if(m.status===1||m.status===2){\n    var sc=m.score&&m.score!=='-'?esc(m.score):'0 - 0';\n    center='<div class=\"score\">'+sc+'</div>';\n  }else{\n    center='<div class=\"kick-time\">'+esc(m.time)+'</div><div class=\"kick-label\">Kick-off</div>';\n  }\n  var foot=live?'<div class=\"card-foot\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 12 12\" aria-hidden=\"true\"><polygon points=\"2,1 11,6 2,11\" fill=\"#fff\"/></svg>Watch on '+BRAND+'</div>':'';\n  var inner=\n    '<div class=\"card-head\">'+\n      '<div class=\"league-row\">'+\n        '<img src=\"'+LIMG+esc(m.league_logo)+'\" alt=\"'+esc(m.league_en)+'\" class=\"league-img\" loading=\"lazy\" width=\"20\" height=\"20\" onerror=\"this.style.display=\\'none\\'\">'+\n        '<span class=\"league-name\">'+esc(m.league_en)+'</span>'+\n      '</div>'+\n      '<span class=\"badge '+st.cls+'\">'+st.label+'</span>'+\n    '</div>'+\n    '<div class=\"card-body\">'+\n      '<div class=\"teams\">'+\n        '<div class=\"team\">'+\n          '<img src=\"'+TIMG+esc(m.home_logo)+'\" alt=\"'+esc(m.home_en)+'\" class=\"team-logo\" loading=\"lazy\" width=\"48\" height=\"48\" onerror=\"this.src=\\''+FALLBACK+'\\'\">'+\n          '<span class=\"team-name\">'+esc(m.home_en)+'</span>'+\n        '</div>'+\n        '<div class=\"center-col\">'+center+'</div>'+\n        '<div class=\"team\">'+\n          '<img src=\"'+TIMG+esc(m.away_logo)+'\" alt=\"'+esc(m.away_en)+'\" class=\"team-logo\" loading=\"lazy\" width=\"48\" height=\"48\" onerror=\"this.src=\\''+FALLBACK+'\\'\">'+\n          '<span class=\"team-name\">'+esc(m.away_en)+'</span>'+\n        '</div>'+\n      '</div>'+\n    '</div>'+foot;\n  if(live){\n    return '<a href=\"'+link+'\" class=\"card'+(m.status===2?' finished':'')+'\" target=\"_blank\" rel=\"noopener noreferrer nofollow\" aria-label=\"Watch '+esc(m.home_en)+' vs '+esc(m.away_en)+' live on '+BRAND+'\">'+inner+'</a>';\n  }\n  return '<div class=\"card'+(m.status===2?' finished':'')+'\" aria-label=\"'+esc(m.home_en)+' vs '+esc(m.away_en)+'\">'+inner+'</div>';\n}\n\nfunction show(id,d){document.getElementById(id).style.display=d||'block'}\nfunction hide(id){document.getElementById(id).style.display='none'}\n\nfunction load(){\n  var url=API+'api/matches/'+today()+'/1?t='+ts();\n  fetch(url).then(function(r){if(!r.ok)throw new Error('err');return r.json()})\n  .then(function(data){\n    hide('loading');\n    var matches=data.matches;\n    if(!matches.length){\n      show('loading');\n      document.getElementById('loading').innerHTML='<div class=\"state-icon\" aria-hidden=\"true\">⚽</div><h3>No matches right now</h3><p>Check back soon — new fixtures are added daily on '+BRAND+'.</p>';\n      return;\n    }\n    document.getElementById('grid').innerHTML=matches.map(card).join('');\n    show('grid','grid');\n  }).catch(function(){hide('loading');show('error')});\n}\n\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',load);\nelse load();\n})();\n</script>\n<script defer=\"\" src=\"https://static.cloudflareinsights.com/beacon.min.js/v4513226cdae34746b4dedf0b4dfa099e1781791509496\" integrity=\"sha512-ZE9pZaUXND66v380QUtch/5sE9tPFh2zg45pR2PB0CVkCtOREv2AJKkSidISWkysEuQ0EH8faUU5du78bx87UQ==\" data-cf-beacon=\"{&quot;version&quot;:&quot;2024.11.0&quot;,&quot;token&quot;:&quot;a40fa2fa04644eeb9c59c1443911d9df&quot;,&quot;r&quot;:1,&quot;server_timing&quot;:{&quot;name&quot;:{&quot