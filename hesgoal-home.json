d. Just visit the site and click any match to start watching instantly.\"}}\n    ]}\n  ]\n}\n</script>\n\n<style>\n/* ── TOKENS ───────────────────────────────────────────────────────────────── */\n:root{\n  --red:#dc2626;--red-d:#b91c1c;--red-l:#ef4444;--red-xl:#fef2f2;--red-xl2:#fee2e2;\n  --bg:#f8fafc;--bg2:#f1f5f9;--surface:#ffffff;--surface2:#f8fafc;\n  --border:#e2e8f0;--border-r:rgba(220,38,38,.18);\n  --text:#0f172a;--muted:#64748b;--dim:#94a3b8;\n  --radius:12px;--radius-lg:18px;\n  --shadow:0 1px 3px rgba(0,0,0,.06),0 4px 16px rgba(0,0,0,.06);\n  --shadow-md:0 4px 12px rgba(0,0,0,.08),0 8px 32px rgba(0,0,0,.06);\n  --shadow-r:0 4px 20px rgba(220,38,38,.18);\n  --grad:linear-gradient(135deg,#dc2626,#b91c1c);\n  --grad-soft:linear-gradient(135deg,#fef2f2,#fee2e2);\n}\n*,::before,::after{box-sizing:border-box;margin:0;padding:0}\nhtml{font-size:16px;scroll-behavior:smooth;-webkit-text-size-adjust:100%}\nbody{font-family:'Inter',system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--bg);color:var(--text);line-height:1.6;min-height:100svh;overflow-x:hidden}\nimg{max-width:100%;display:block}\na{color:inherit;text-decoration:none}\n::selection{background:var(--red);color:#fff}\n\n/* ── NAV ────────────────────────────────────────────────────────────────── */\n.nav{position:sticky;top:0;z-index:100;background:rgba(255,255,255,.92);backdrop-filter:saturate(180%) blur(20px);-webkit-backdrop-filter:saturate(180%) blur(20px);border-bottom:1px solid var(--border);padding:0 24px;height:62px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 1px 0 var(--border)}\n.nav-brand{display:flex;align-items:center;gap:10px;color:var(--text);font-weight:900;font-size:20px;letter-spacing:-.5px}\n.nav-logo{width:34px;height:34px;background:var(--grad);border-radius:9px;display:grid;place-items:center;font-size:18px;font-weight:900;color:#fff;box-shadow:var(--shadow-r)}\n.nav-links{display:flex;gap:6px;align-items:center}\n.nav-links a{color:var(--muted);font-size:13px;font-weight:600;padding:6px 12px;border-radius:8px;transition:all .15s}\n.nav-links a:hover{color:var(--red);background:var(--red-xl)}\n.nav-badge{background:var(--red);color:#fff;font-size:10px;font-weight:800;padding:4px 10px;border-radius:6px;letter-spacing:.7px;text-transform:uppercase}\n@media(max-width:680px){.nav-links{display:none}}\n\n/* ── HERO ───────────────────────────────────────────────────────────────── */\n.hero{background:linear-gradient(160deg,#fff 0%,var(--red-xl) 60%,var(--red-xl2) 100%);border-bottom:1px solid var(--border-r);padding:56px 24px 48px;text-align:center;position:relative;overflow:hidden}\n.hero::before{content:\"\";position:absolute;inset:0;background:url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23dc2626' fill-opacity='0.04'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\") repeat;pointer-events:none}\n.hero-eyebrow{display:inline-flex;align-items:center;gap:7px;background:#fff;border:1px solid var(--border-r);color:var(--red);font-size:11px;font-weight:800;padding:5px 14px;border-radius:20px;letter-spacing:.7px;text-transform:uppercase;margin-bottom:18px;box-shadow:var(--shadow-r)}\n.hero-dot{width:7px;height:7px;background:var(--red);border-radius:50%;animation:blink 1.2s infinite}\n.hero h1{font-size:clamp(30px,6vw,58px);font-weight:900;line-height:1.06;margin-bottom:16px;letter-spacing:-1.5px;color:var(--text)}\n.hero h1 em{font-style:normal;color:var(--red)}\n.hero .lead{font-size:clamp(15px,2vw,18px);color:var(--muted);max-width:640px;margin:0 auto 32px;line-height:1.7}\n.hero-stats{display:flex;gap:0;justify-content:center;flex-wrap:wrap;background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);box-shadow:var(--shadow);max-width:520px;margin:0 auto;overflow:hidden}\n.hero-stat{flex:1;min-width:100px;padding:16px 12px;text-align:center;border-right:1px solid var(--border)}\n.hero-stat:last-child{border-right:none}\n.hero-stat strong{display:block;font-size:clamp(18px,3vw,24px);font-weight:900;color:var(--red)}\n.hero-stat span{font-size:11px;color:var(--muted);letter-spacing:.3px}\n\n@keyframes blink{0%,100%{opacity:1}50%{opacity:.3}}\n@keyframes spin{to{transform:rotate(360deg)}}\n@keyframes fadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}\n\n/* ── LAYOUT ─────────────────────────────────────────────────────────────── */\n.wrap{max-width:1240px;margin:0 auto;padding:0 20px}\n.section-head{display:flex;align-items:center;justify-content:space-between;margin:36px 0 16px;flex-wrap:wrap;gap:10px}\n.section-head h2{font-size:clamp(18px,2.5vw,22px);font-weight:900;letter-spacing:-.4px;display:flex;align-items:center;gap:10px;color:var(--text)}\n.section-head h2::before{content:\"\";width:4px;height:22px;background:var(--grad);border-radius:2px;flex-shrink:0}\n.section-head .meta{font-size:12px;color:var(--muted);background:var(--bg2);padding:4px 10px;border-radius:6px;border:1px solid var(--border)}\n\n/* ── MATCH CARDS ────────────────────────────────────────────────────────── */\n.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}\n.card{background:var(--surface);border-radius:var(--radius);border:1px solid var(--border);overflow:hidden;transition:all .25s cubic-bezier(.4,0,.2,1);display:block;position:relative;box-shadow:var(--shadow)}\n.card:hover{transform:translateY(-3px);border-color:var(--border-r);box-shadow:var(--shadow-r)}\n.card.finished{opacity:.6}\n.card-head{background:var(--bg2);border-bottom:1px solid var(--border);padding:9px 12px;display:flex;align-items:center;justify-content:space-between;gap:8px}\n.league-row{display:flex;align-items:center;gap:7px;min-width:0}\n.league-img{width:20px;height:20px;object-fit:contain;flex-shrink:0}\n.league-name{font-size:11px;font-weight:700;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;letter-spacing:.2px;text-transform:uppercase}\n.badge{font-size:10px;font-weight:800;padding:3px 9px;border-radius:20px;white-space:nowrap;flex-shrink:0;letter-spacing:.5px;text-transform:uppercase}\n.badge-live{background:var(--red);color:#fff;display:flex;align-items:center;gap:5px}\n.badge-live .dot{display:inline-block;width:5px;height:5px;background:#fff;border-radius:50%;animation:blink 1.2s infinite}\n.badge-upcoming{background:var(--red-xl);color:var(--red-d);border:1px solid var(--border-r)}\n.badge-finished{background:var(--bg2);color:var(--dim);border:1px solid var(--border)}\n.card-body{padding:18px 14px}\n.teams{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:8px}\n.team{display:flex;flex-direction:column;align-items:center;gap:7px}\n.team-logo{width:48px;height:48px;object-fit:contain;filter:drop-shadow(0 2px 6px rgba(0,0,0,.1))}\n.team-name{font-size:12px;font-weight:700;text-align:center;line-height:1.3;color:var(--text)}\n.center-col{display:flex;flex-direction:column;align-items:center;gap:2px;min-width:56px}\n.score{font-size:24px;font-weight:900;color:var(--text);letter-spacing:2px;font-variant-numeric:tabular-nums}\n.kick-time{font-size:14px;font-weight:900;color:var(--red);white-space:nowrap;font-variant-numeric:tabular-nums}\n.kick-label{font-size:9px;color:var(--dim);text-transform:uppercase;letter-spacing:1px;margin-top:1px}\n.card-foot{border-top:1px solid var(--border-r);padding:10px 14px;display:flex;align-items:center;justify-content:center;gap:7px;background:var(--grad);color:#fff;font-size:12px;font-weight:800;letter-spacing:.5px;text-transform:uppercase;transition:all .2s}\n.card:hover .card-foot{background:linear-gradient(135deg,#b91c1c,#991b1b)}\n\n/* ── STATES ─────────────────────────────────────────────────────────────── */\n.state{text-align:center;padding:60px 20px;color:var(--muted)}\n.state-icon{font-size:48px;margin-bottom:14px;opacity:.5}\n.state h3{font-size:17px;font-weight:800;margin-bottom:6px;color:var(--text)}\n.state p{font-size:14px}\n.spinner{width:44px;height:44px;border:3px solid var(--border-r);border-top-color:var(--red);border-radius:50%;animation:spin .75s linear infinite;margin:0 auto 14px}\n\n/* ── FEATURES ───────────────────────────────────────────────────────────── */\n.feature-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:12px;margin:4px 0 20px}\n.feature{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:22px;display:flex;gap:14px;align-items:flex-start;transition:all .2s;box-shadow:var(--shadow)}\n.feature:hover{border-color:var(--border-r);box-shadow:var(--shadow-r);transform:translateY(-2px)}\n.feature-icon{width:42px;height:42px;background:var(--red-xl);border:1px solid var(--border-r);border-radius:10px;display:grid;place-items:center;flex-shrink:0;font-size:20px}\n.feature h3{font-size:14px;font-weight:800;color:var(--text);margin-bottom:4px}\n.feature p{font-size:13px;color:var(--muted);line-height:1.6}\n\n/* ── INFO SECTIONS ──────────────────────────────────────────────────────── */\n.section{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:32px 28px;margin:16px 0;box-shadow:var(--shadow)}\n.section h2{font-size:clamp(18px,2.5vw,22px);font-weight:900;color:var(--text);margin-bottom:14px;letter-spacing:-.4px;display:flex;align-items:center;gap:10px}\n.section h2::before{content:\"\";width:4px;height:22px;background:var(--grad);border-radius:2px;flex-shrink:0}\n.section h3{font-size:16px;font-weight:800;color:var(--text);margin:18px 0 7px}\n.section p{font-size:15px;color:var(--muted);line-height:1.8;margin-bottom:10px}\n.section strong{color:var(--red-d);font-weight:700}\n\n/* ── LEAGUES GRID ───────────────────────────────────────────────────────── */\n.leagues-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:8px;margin:14px 0}\n.league-tag{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:11px 14px;font-size:13px;font-weight:600;color:var(--text);display:flex;align-items:center;gap:9px;transition:all .18s;box-shadow:var(--shadow)}\n.league-tag:hover{border-color:var(--border-r);background:var(--red-xl);transform:translateX(2px)}\n.league-tag-icon{font-size:18px;flex-shrink:0;line-height:1}\n.league-tag-info strong{display:block;font-size:13px;font-weight:800;color:var(--text)}\n.league-tag-info span{font-size:11px;color:var(--muted)}\n\n/* ── STEPS ──────────────────────────────────────────────────────────────── */\n.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:14px;margin:16px 0}\n.step{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:26px 20px;position:relative;overflow:hidden;box-shadow:var(--shadow);transition:all .2s}\n.step:hover{border-color:var(--border-r);box-shadow:var(--shadow-r)}\n.step-bg-num{position:absolute;top:12px;right:14px;font-size:52px;font-weight:900;color:rgba(220,38,38,.06);line-height:1;pointer-events:none}\n.step-num{width:34px;height:34px;background:var(--grad);border-radius:50%;display:grid;place-items:center;font-size:14px;font-weight:900;color:#fff;margin-bottom:12px;box-shadow:var(--shadow-r)}\n.step h3{font-size:15px;font-weight:800;color:var(--text);margin-bottom:6px}\n.step p{font-size:13px;color:var(--muted);line-height:1.65}\n\n/* ── FAQ ────────────────────────────────────────────────────────────────── */\n.faq-wrap{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow)}\n.faq-item{border-bottom:1px solid var(--border)}\n.faq-item:last-child{border-bottom:none}\n.faq-item summary{cursor:pointer;font-size:14px;font-weight:700;color:var(--text);padding:16px 20px;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:12px;transition:background .15s}\n.faq-item summary::-webkit-details-marker{display:none}\n.faq-item summary:hover{background:var(--red-xl)}\n.faq-item summary::after{content:\"+\";color:var(--red);font-size:22px;font-weight:300;transition:transform .2s;flex-shrink:0}\n.faq-item[open] summary{background:var(--red-xl);color:var(--red-d)}\n.faq-item[open] summary::after{transform:rotate(45deg)}\n.faq-item p{font-size:13px;color:var(--muted);line-height:1.75;padding:0 20px 16px}\n\n/* ── FOOTER ─────────────────────────────────────────────────────────────── */\nfooter{background:#fff;border-top:1px solid var(--border);padding:44px 20px 24px;margin-top:48px}\n.footer-inner{max-width:1000px;margin:0 auto;text-align:center}\n.foot-brand{display:inline-flex;align-items:center;gap:10px;font-size:22px;font-weight:900;color:var(--text);margin-bottom:10px}\n.foot-desc{color:var(--muted);font-size:14px;max-width:560px;margin:0 auto 20px;line-height:1.7}\n.foot-leagues{display:flex;gap:6px;justify-content:center;flex-wrap:wrap;margin:0 0 18px}\n.foot-league{background:var(--bg2);border:1px solid var(--border);color:var(--muted);font-size:11px;font-weight:600;padding:4px 11px;border-radius:6px;transition:all .15s}\n.foot-league:hover{background:var(--red-xl);color:var(--red);border-color:var(--border-r)}\n.foot-links{display:flex;gap:18px;justify-content:center;flex-wrap:wrap;margin-bottom:22px}\n.foot-links a{font-size:13px;color:var(--dim);transition:color .15s}\n.foot-links a:hover{color:var(--red)}\n.foot-copy{color:var(--dim);font-size:12px;border-top:1px solid var(--border);padding-top:16px}\n\n/* ── RESPONSIVE ─────────────────────────────────────────────────────────── */\n@media(max-width:600px){\n  .grid{grid-template-columns:1fr}\n  .team-logo{width:40px;height:40px}\n  .score{font-size:20px}\n  .hero{padding:40px 16px 32px}\n  .hero-stats{flex-wrap:nowrap;overflow-x:auto}\n  .section{padding:22px 16p